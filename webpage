  background:var(--black);color:var(--white);
  font-size:0.65rem;font-weight:700;letter-spacing:0.1em;
  text-transform:uppercase;padding:0.2rem 0.8rem;
  border-radius:0 0 4px 4px;
  font-family:var(--font-head);
}

/* STACK */
#stack{background:var(--white);}
.stack-layout{
  display:flex;align-items:center;justify-content:space-between;
  gap:4rem;flex-wrap:wrap;
}
.stack-pills{
  display:flex;flex-wrap:wrap;gap:0.6rem;
  max-width:560px;
}
.spill{
  border:1px solid var(--border);border-radius:100px;
  padding:0.45rem 1rem;font-size:0.8rem;
  color:var(--muted);transition:all 0.2s;
  cursor:default;
}
.spill:hover{border-color:var(--black);color:var(--black);}

/* FAQ */
#faq{background:var(--off);}
.faq-layout{
  display:grid;grid-template-columns:380px 1fr;
  gap:5rem;max-width:1100px;
}
.faq-list{display:flex;flex-direction:column;}
.faq-item{border-bottom:1px solid rgba(0,0,0,0.1);}
.faq-q{
  display:flex;align-items:center;justify-content:space-between;
  padding:1.5rem 0;cursor:pointer;
  font-family:var(--font-head);font-size:1rem;
  font-weight:700;letter-spacing:-0.02em;
  transition:color 0.2s;gap:1rem;
}
.faq-q:hover{color:var(--orange);}
.faq-plus{
  font-size:1.3rem;color:var(--muted);
  transition:transform 0.3s;flex-shrink:0;
  line-height:1;
}
.faq-item.open .faq-plus{transform:rotate(45deg);color:var(--orange);}
.faq-a{
  max-height:0;overflow:hidden;
  font-size:0.875rem;color:var(--muted);
  line-height:1.7;font-weight:300;
  transition:max-height 0.4s ease,padding 0.3s;
  padding-bottom:0;
}
.faq-item.open .faq-a{max-height:160px;padding-bottom:1.5rem;}

/* CTA */
#cta{
  background:var(--black);
  padding:8rem 3rem;
  text-align:center;position:relative;overflow:hidden;
}
#cta::before{
  content:'START';
  font-family:var(--font-head);
  font-size:28vw;font-weight:700;
  letter-spacing:-0.06em;
  color:rgba(255,255,255,0.02);
  position:absolute;top:50%;left:50%;
  transform:translate(-50%,-50%);
  pointer-events:none;white-space:nowrap;
  line-height:1;
}
#cta .s-label{color:var(--orange);justify-content:center;}
#cta h2.display{color:var(--white);margin-bottom:1rem;}
#cta p{color:rgba(255,255,255,0.45);max-width:420px;margin:0 auto 2.5rem;font-size:0.95rem;line-height:1.65;font-weight:300;}
.cta-btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;}
.btn-white{
  background:var(--white);color:var(--black);
  padding:0.8rem 2rem;
  font-family:var(--font-head);font-weight:700;
  font-size:0.9rem;border-radius:4px;
  text-decoration:none;transition:background 0.2s;
  display:inline-flex;align-items:center;gap:0.5rem;
}
.btn-white:hover{background:var(--orange);color:var(--white);}
.btn-ghost-w{
  color:rgba(255,255,255,0.45);font-size:0.9rem;
  text-decoration:none;border-bottom:1px solid rgba(255,255,255,0.15);
  padding-bottom:1px;transition:color 0.2s,border-color 0.2s;
}
.btn-ghost-w:hover{color:var(--white);border-color:var(--white);}

/* FOOTER */
footer{
  background:var(--black);
  border-top:1px solid rgba(255,255,255,0.06);
  padding:4rem 3rem 2rem;
}
.footer-top{
